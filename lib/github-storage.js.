
const API = "https://api.github.com";

function getConfig() {
  const owner = process.env.GITHUB_OWNER;
  const repo = process.env.GITHUB_REPO;
  const token = process.env.GITHUB_TOKEN;
  const branch = process.env.GITHUB_BRANCH || "main";

  if (!owner || !repo || !token) {
    throw new Error("GitHub storage environment variables are missing.");
  }

  return { owner, repo, token, branch };
}

function getHeaders(token) {
  return {
    Authorization: `Bearer ${token}`,
    Accept: "application/vnd.github+json",
    "X-GitHub-Api-Version": "2022-11-28"
  };
}

function fileURL(owner, repo, path, branch) {
  const safePath = path
    .split("/")
    .map(encodeURIComponent)
    .join("/");

  return `${API}/repos/${owner}/${repo}/contents/${safePath}?ref=${encodeURIComponent(branch)}`;
}

async function readJSON(path, fallback = {}) {
  const { owner, repo, token, branch } = getConfig();

  const response = await fetch(
    fileURL(owner, repo, path, branch),
    { headers: getHeaders(token) }
  );

  if (response.status === 404) {
    return fallback;
  }

  if (!response.ok) {
    throw new Error(
      `GitHub read failed (${response.status}): ${await response.text()}`
    );
  }

  const file = await response.json();

  if (!file.content) {
    throw new Error(`GitHub returned no content for ${path}`);
  }

  const decoded = Buffer.from(
    file.content.replace(/\n/g, ""),
    "base64"
  ).toString("utf8");

  return JSON.parse(decoded);
}

async function writeJSON(path, data) {
  const { owner, repo, token, branch } = getConfig();

  const url = fileURL(owner, repo, path, branch)
    .split("?")[0];

  const headers = getHeaders(token);

  // Get the existing file SHA if the file already exists.
  const existingResponse = await fetch(
    `${url}?ref=${encodeURIComponent(branch)}`,
    { headers }
  );

  let sha;

  if (existingResponse.ok) {
    const existing = await existingResponse.json();
    sha = existing.sha;
  } else if (existingResponse.status !== 404) {
    throw new Error(
      `GitHub lookup failed (${existingResponse.status}): ${await existingResponse.text()}`
    );
  }

  const content = Buffer.from(
    JSON.stringify(data, null, 2),
    "utf8"
  ).toString("base64");

  const payload = {
    message: `Update ${path}`,
    content,
    branch
  };

  if (sha) {
    payload.sha = sha;
  }

  const response = await fetch(url, {
    method: "PUT",
    headers: {
      ...headers,
      "Content-Type": "application/json"
    },
    body: JSON.stringify(payload)
  });

  if (!response.ok) {
    throw new Error(
      `GitHub write failed (${response.status}): ${await response.text()}`
    );
  }

  return await response.json();
}

module.exports = {
  readJSON,
  writeJSON
};
